# =============================================================================
# Agent Health - Environment Variables
# =============================================================================
#
# Most users need NO configuration to get started!
# Just run: npx agent-health run -t demo-otel-001 -a demo
#
# Set variables below for additional features:
# - AWS credentials for Claude Code and Bedrock judge
# - OpenSearch storage to persist results
# - OpenSearch observability for agent traces
#

# =============================================================================
# AWS CREDENTIALS (usually auto-detected from ~/.aws/credentials)
# =============================================================================
# Required for: Claude Code agent, Bedrock judge
# If you've run `aws configure`, these are already set!

# AWS_PROFILE=Bedrock
# AWS_REGION=us-west-2

# =============================================================================
# OPENSEARCH STORAGE (optional - for saving results)
# =============================================================================
# Without storage: Results shown in terminal, no persistence
# With storage: Results saved, viewable in UI, history tracking

# OPENSEARCH_STORAGE_ENDPOINT=https://your-cluster.amazonaws.com
# OPENSEARCH_STORAGE_USERNAME=admin
# OPENSEARCH_STORAGE_PASSWORD=your_password

# For AWS SigV4 authentication (instead of username/password):
# OPENSEARCH_STORAGE_AUTH_TYPE=sigv4
# OPENSEARCH_STORAGE_AWS_REGION=us-east-1
# OPENSEARCH_STORAGE_AWS_PROFILE=MyProfile
# OPENSEARCH_STORAGE_AWS_SERVICE=es

# =============================================================================
# OPENSEARCH OBSERVABILITY (optional - for agent traces)
# =============================================================================
# Only needed if using ML-Commons agent with tracing enabled

# OPENSEARCH_LOGS_ENDPOINT=https://your-cluster.amazonaws.com
# OPENSEARCH_LOGS_USERNAME=admin
# OPENSEARCH_LOGS_PASSWORD=your_password
# OPENSEARCH_LOGS_TRACES_INDEX=otel-v1-apm-span-*
# OPENSEARCH_LOGS_INDEX=ml-commons-logs-*

# For AWS SigV4 authentication (instead of username/password):
# OPENSEARCH_LOGS_AUTH_TYPE=sigv4
# OPENSEARCH_LOGS_AWS_REGION=us-west-2
# OPENSEARCH_LOGS_AWS_PROFILE=MyProfile
# OPENSEARCH_LOGS_AWS_SERVICE=es

# =============================================================================
# OBSERVIO SAMPLE AGENT (optional - endpoint for the bundled sample agent)
# =============================================================================
# The Observio sample agent ships in the observio-sample-agent/ folder.
# Start it with: cd observio-sample-agent && npm install && npm run start:ag-ui

# OBSERVIO_ENDPOINT=http://localhost:3001/run-agent

# =============================================================================
# DEBUG MODE (optional)
# =============================================================================
# Enable verbose debug logging on the server (also toggleable from Settings UI)

# DEBUG=false

# =============================================================================
# CLAUDE CODE TELEMETRY (optional - for OTEL traces from Claude Code agent)
# =============================================================================
# Enable to send OpenTelemetry metrics/events from Claude Code executions.
# Requires an OTLP-compatible endpoint (e.g., AWS OSIS, Jaeger, Grafana).
# When enabled, traces are polled and displayed in the UI after agent execution.

# CLAUDE_CODE_TELEMETRY_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=claude-code-agent
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token

# =============================================================================
# OPENAI-COMPATIBLE JUDGE (optional - alternative to AWS Bedrock for evaluation)
# =============================================================================
# Use any OpenAI-compatible endpoint (OpenAI, Ollama, Azure, Anthropic, etc.)
# as the LLM judge instead of AWS Bedrock.
#
# To use: set provider: "openai-compatible" on a model in agent-health.config.ts
#
# OPENAI_COMPATIBLE_API_KEY=sk-...
# OPENAI_COMPATIBLE_ENDPOINT=http://localhost:4000/v1/chat/completions  # LiteLLM proxy
# OPENAI_COMPATIBLE_ENDPOINT=https://api.openai.com/v1/chat/completions # Direct OpenAI

# =============================================================================
# AMAZON STRANDS (optional - for Strands agent connector)
# =============================================================================
# Required when using the Strands connector to invoke Bedrock agents.
# AWS credentials above are used for authentication.

# STRANDS_AGENT_ID=your-agent-id
# STRANDS_ALIAS_ID=TSTALIASID

# =============================================================================
# LANGGRAPH REST (optional - for non-AG-UI LangGraph agents)
# =============================================================================
# For LangGraph agents exposed via direct REST API (not AG-UI streaming).

# LANGGRAPH_API_ENDPOINT=http://localhost:8000

# =============================================================================
# ADVANCED: Server Configuration (rarely needed)
# =============================================================================
# AH_PORT=4001
# AH_DEV_PORT=4000
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Other env vars accepted by agent-health (all opt-in):
#   AH_HEADLESS=1                   Run API server only, no frontend
#   AH_API_KEY=<key>                Require Bearer token on /api/coding-agents/*
#   AH_USERNAME=<user>              Override detected unix username
#   AH_DISABLE_CODING_ANALYTICS=true  Turn off the Coding Agent Analytics feature
#   AH_SUPPRESS_EXPERIMENTAL=1      Silence the experimental SDK warning
#   AH_QUIET_DEPRECATIONS=1         Silence env-var deprecation warnings
#
# Legacy names (AGENT_HEALTH_PORT, AGENT_HEALTH_DEV_PORT,
# AGENT_HEALTH_API_KEY, AGENT_HEALTH_HEADLESS, AGENT_HEALTH_USERNAME,
# AGENT_HEALTH_DISABLE_CODING_ANALYTICS, AGENT_HEALTH_SUPPRESS_EXPERIMENTAL)
# are still accepted but emit a one-time deprecation warning. They will be
# removed in a future release.
